# Copy to .env and fill in. Every variable is optional except GOOGLE_API_KEY
# when LLM_PROVIDER=gemini.

# --- LLM -------------------------------------------------------------------
# gemini = real model (free tier) | fake = scripted offline model for tests
LLM_PROVIDER=gemini
# Get a free key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# Model names change over time; list yours with the snippet in the README.
GEMINI_MODEL=gemini-3.8-flash
# Cheaper model for light steps (query planning, page selection). Quotas are
# per model, so this stretches the free tier's daily budget.
GEMINI_FAST_MODEL=gemini-3.5-flash-lite
# On a quota (429) or overload (503) error, retry strong-tier calls on the fast model.
LLM_FALLBACK_TO_FAST=true
LLM_TEMPERATURE=0.2
# Client-side throttle. Keep this below your model's free-tier RPM limit.
LLM_REQUESTS_PER_MINUTE=8

# --- SEC EDGAR corpus (scripts/fetch_edgar.py) ---------------------------------
# SEC requires a User-Agent naming you and a contact email, and answers 403
# without one. Empty = the project maintainer's. Use your own, e.g.
# SEC_USER_AGENT=Jane Doe jane@example.com
SEC_USER_AGENT=

# --- RAG -------------------------------------------------------------------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Changing the model or chunking needs a re-index: uv run python -m analyst.rag.index
CHUNK_SIZE=800
CHUNK_OVERLAP=120
RETRIEVAL_K=5
# Which 10-K Items to index. Item 8 (financial statements) is off by default:
# mostly tables, and the SQL agent has those figures exactly. Re-index after changing.
EDGAR_ITEMS=1,1A,3,7,7A

# --- Data analysis (SQL guardrails) ------------------------------------------
SQL_MAX_ROWS=500
SQL_TIMEOUT_SECONDS=5

# --- Web research ------------------------------------------------------------
WEB_MAX_RESULTS=5
WEB_MAX_PAGES=3
WEB_TIMEOUT_SECONDS=10
WEB_RESPECT_ROBOTS=true

# --- Loop budgets (guarantee the reflection loops end) ----------------------
MAX_REVISIONS=2
MAX_RESEARCH_ROUNDS=1
MAX_SUBTASKS=6

# --- Human-in-the-loop -------------------------------------------------------
# true = pause at the human gate for approval | false = auto-approve (batch/evals)
HUMAN_REVIEW=true

# --- API (scripts/serve.py) --------------------------------------------------
# Runs executing at once; more wait their turn (free-tier LLM quotas are small).
API_MAX_CONCURRENT_RUNS=2

# --- Langfuse Cloud tracing (optional; tracing is a no-op if keys are blank) -
# Free account: https://cloud.langfuse.com -> create a project -> Settings ->
# API Keys. Tracing turns on only when BOTH keys below are set. Each graph run
# then appears as one trace named after the question, tagged with its thread
# id (the id scripts/review.py prints), with a span per node and LLM call
# (prompts, outputs, latency, tokens). Runs paused at the human gate are
# grouped by session (= thread id).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# EU region by default; use https://us.cloud.langfuse.com for the US region.
LANGFUSE_HOST=https://cloud.langfuse.com
